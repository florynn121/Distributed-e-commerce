# Copy to .env.production and set fresh secrets before starting the origin.
# Keep .env.production readable only by the deployment user.
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=
RABBITMQ_USER=commerce
RABBITMQ_PASSWORD=
CHECKOUT_SERVICE_TOKEN=
EDGE_ORIGIN_TOKEN=
PUBLIC_ORIGIN=https://shop.example.com
CLOUDFLARE_ACCESS_ISSUER=https://team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=

# Only needed with the tunnel profile. Store the connector's token in this file.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token

# Set a key if also running the optional search profile.
# QDRANT__SERVICE__API_KEY=
