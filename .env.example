# Local development values. Copy this file to .env.
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=local-postgres-password
RABBITMQ_USER=commerce
RABBITMQ_PASSWORD=local-rabbitmq-password
CHECKOUT_SERVICE_TOKEN=local-checkout-token-change-for-production
JWT_SECRET=local-jwt-secret-change-for-production
GATEWAY_LOGIN_PASSWORD=local-storefront-password
GATEWAY_PORT=3000

# Optional local product-search profile.
# QDRANT__SERVICE__API_KEY=

# Production overlay variables (use a separate env file with fresh secrets).
# PUBLIC_ORIGIN=https://shop.example.com
# CLOUDFLARE_ACCESS_ISSUER=https://team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUDIENCE=
# EDGE_ORIGIN_TOKEN=
# CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token
